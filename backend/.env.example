# Kraken Trading Bot environment template.
# Copy this file to .env in the same backend directory, then edit values for
# your local machine. BotSettings is case-sensitive, so keep keys uppercase.

# ---------------------------------------------------------------------------
# Application metadata
# ---------------------------------------------------------------------------
# Display name used by the app and logs. This is cosmetic and does not affect
# trading behavior.
APP_NAME=Kraken Trading Bot

# Application version string shown in metadata and useful for local release
# tracking. Keep this aligned with release notes when packaging changes.
VERSION=0.3.0

# Enables development-mode behavior. Valid boolean values include true/false,
# 1/0, yes/no, and on/off. Use false for normal operation.
DEBUG=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Address Uvicorn binds to. Use 127.0.0.1 for local-only access, or 0.0.0.0
# only when you explicitly want LAN/container access.
HOST=127.0.0.1

# HTTP port for the FastAPI server and dashboard.
PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy connection string. The project is designed for SQLite; this path is
# relative to the backend working directory when the app is launched there.
DATABASE_URL=sqlite:///./trading_bot.db

# ---------------------------------------------------------------------------
# Trading capital and currency
# ---------------------------------------------------------------------------
# Quote currency used for cash, equity, P&L display, and default market pairs.
BASE_CURRENCY=EUR

# Starting cash balance for the paper execution engine.
STARTING_CAPITAL=500.0

# Preferred notional order value in BASE_CURRENCY. Risk targets this amount,
# reduces it when available cash is lower, and rejects below MIN_TRADE_SIZE.
TARGET_TRADE_AMOUNT=100.0

# ---------------------------------------------------------------------------
# Risk controls
# ---------------------------------------------------------------------------
# Maximum estimated loss allowed on a single trade as a percentage of current
# equity. RiskEngine rejects trades whose stop-loss assumption exceeds this.
MAX_LOSS_PER_TRADE_PERCENT=5.0

# Maximum cumulative realised daily loss as a percentage of starting daily
# equity. Once breached, new trades are blocked until the risk date resets.
MAX_DAILY_LOSS_PERCENT=5.0

# Minimum notional order value in BASE_CURRENCY. Risk may clamp or reduce trade
# sizing, but will reject when the final spendable amount is below this floor.
MIN_TRADE_SIZE=50.0

# Fractional stop loss used for risk checks and stop-loss exits. 0.05 means 5%.
STOP_LOSS_PCT=0.05

# Combined fee and slippage assumption used in risk sizing. Default is Kraken
# taker fee estimate 0.26% plus conservative slippage estimate 0.10%.
FEE_AND_SLIPPAGE=0.0036

# Minimum strategy confidence required for fully_automated execution. Manual and
# semi_automated modes can still surface lower-confidence signals for review.
MIN_SIGNAL_CONFIDENCE=0.65

# If the LLM analysis returns a confidence scale below this value, the signal is
# vetoed. Set to 0.0 to disable veto behavior while keeping LLM scaling.
LLM_VETO_THRESHOLD=0.70

# Minimum 24-hour market volume required by the risk engine. 0.0 disables the
# liquidity gate; raise it to avoid trading illiquid pairs.
MIN_24H_VOLUME=0.0

# Optional webhook URL for important alerts such as emergency stop, daily loss
# limit, stop-loss exits, and bot restart. Leave blank to disable alerts.
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Trading modes
# ---------------------------------------------------------------------------
# manual: signals are shown only, no orders are placed.
# semi_automated: approved risk decisions enter the approval queue.
# fully_automated: approved signals execute immediately if confidence allows.
TRADING_MODE=manual

# paper: simulated execution with fees/slippage and no real funds.
# live: real Kraken order submission for live-enabled markets.
TRADING_ENVIRONMENT=paper

# ---------------------------------------------------------------------------
# Kraken API
# ---------------------------------------------------------------------------
# Kraken credentials are required only for live trading. Leave both blank for
# paper trading and read-only public market data.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ---------------------------------------------------------------------------
# News ingestion
# ---------------------------------------------------------------------------
# RSS/news source names to ingest. Use JSON array syntax for pydantic-settings.
NEWS_SOURCES=["CoinDesk","CoinNews","CoinWeek"]

# ---------------------------------------------------------------------------
# Market universe
# ---------------------------------------------------------------------------
# Always-monitored Kraken markets. Use Kraken's public BASE/QUOTE format.
FIXED_MARKETS=["BTC/EUR","ETH/EUR"]

# Dynamic universe provider. Current implementation expects coinmarketcap.
DYNAMIC_UNIVERSE_SOURCE=coinmarketcap

# Maximum number of dynamic ETH-ecosystem assets to add when dynamic resolution
# is enabled and available.
MAX_ETH_ECOSYSTEM_COINS=10

# ---------------------------------------------------------------------------
# Local LLM — LM Studio (first priority)
# ---------------------------------------------------------------------------
# Base URL for LM Studio's OpenAI-compatible REST server. Start LM Studio and
# load a model before running the bot to use this backend.
LM_STUDIO_URL=http://localhost:1234

# Model identifier sent in API requests. LM Studio ignores this and serves
# whatever model is currently loaded, but the field must be non-empty.
LM_STUDIO_MODEL=google/gemma-4-e4b

# ---------------------------------------------------------------------------
# Local LLM — Ollama (second priority, fallback when LM Studio is unavailable)
# ---------------------------------------------------------------------------
# Base URL for the local Ollama REST API. Run `ollama serve` before starting the
# bot when LLM-backed strategies or analysis are enabled.
OLLAMA_URL=http://localhost:11434

# LLM Model name.
OLLAMA_MODEL=gemma4:e4b
TRANSFORMERS_LLM_MODEL=midnigter/CryptoGemma-4B-v1

# Per-request timeout in seconds. First calls can be slower while Ollama loads
# the model into memory.
OLLAMA_TIMEOUT=60

# Maximum number of concurrent per-market LLM-only recommendations per tick.
# Lower values reduce local model pressure; higher values reduce tick latency.
LLM_ONLY_MAX_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Python logging level. Use INFO for normal operation; DEBUG produces more
# per-tick detail and larger log files.
LOG_LEVEL=INFO

# Log file path relative to the backend working directory.
LOG_FILE=trading_bot.log
