# Kraken Trading Bot — environment template.
# Copy this file to .env in the backend directory and edit values for your machine.
# All keys are case-sensitive; keep them uppercase.

# ── Trading mode ───────────────────────────────────────────────────────────────

# Controls how the bot responds to signals.
# Options: manual | semi_automated | fully_automated
#   manual          — signals visible in dashboard only, no trades placed
#   semi_automated  — signals submitted to approval queue for your review
#   fully_automated — executes immediately when confidence ≥ MIN_SIGNAL_CONFIDENCE
TRADING_MODE=manual

# Whether to trade with real money or simulate locally.
# Options: paper | live
#   paper — safe simulation, no real money at risk
#   live  — real Kraken orders (requires API keys below, use with extreme caution)
TRADING_ENVIRONMENT=paper

# ── Capital & currency ─────────────────────────────────────────────────────────

# Quote currency used for equity, P&L displays, and default market pairs.
BASE_CURRENCY=EUR

# Starting cash balance for the paper trading engine (base currency units).
STARTING_CAPITAL=500.0

# Preferred single order size in base currency.
# The risk engine may reduce this to available cash, but never below MIN_TRADE_SIZE.
TARGET_TRADE_AMOUNT=100.0

# ── Risk controls ──────────────────────────────────────────────────────────────

# Minimum single order value in base currency.
# Orders below this are rejected to avoid uneconomical micro-trades.
MIN_TRADE_SIZE=50.0

# Maximum loss allowed on any single trade as a percentage of total equity.
MAX_LOSS_PER_TRADE_PERCENT=5.0

# Maximum cumulative loss allowed in a single calendar day as a percentage of equity.
# The bot halts trading for the day when this limit is exceeded.
MAX_DAILY_LOSS_PERCENT=5.0

# Auto-close a position when it loses this fraction of its entry value.
# Example: 0.07 = 7% — a position entered at 100 EUR closes at 93 EUR.
STOP_LOSS_PCT=0.07

# Auto-close a position when price retraces this fraction from its peak watermark.
# Example: 0.05 = 5% below the highest price seen since entry.
TRAILING_STOP_PCT=0.05

# Number of 30-second ticks to look back when computing momentum signals.
# Example: 10 ticks = 5 minutes of price history.
MOMENTUM_LOOKBACK_TICKS=10

# Combined taker fee and slippage estimate as a decimal fraction.
# Example: 0.0036 = 0.36% (Kraken taker fee 0.26% + 0.10% slippage allowance).
# Reduce for higher-volume Kraken tiers with lower taker fees.
FEE_AND_SLIPPAGE=0.0036

# ── Signal quality gates ───────────────────────────────────────────────────────

# Minimum signal confidence score required to place a trade in fully_automated mode.
# Range: 0.0–1.0
MIN_SIGNAL_CONFIDENCE=0.65

# LLM veto threshold. If the LLM returns a confidence_scale below this value the
# trade is blocked regardless of the technical signal strength.
# Set to 0.0 to disable the veto (the scale still adjusts confidence, but never blocks).
# Range: 0.0–1.0
LLM_VETO_THRESHOLD=0.70

# Minimum 24-hour trading volume in base currency required to consider a market.
# Set to 0.0 to disable the volume filter.
MIN_24H_VOLUME=0.0

# Optional HTTP webhook URL for outbound trade alerts. Leave blank to disable.
ALERT_WEBHOOK_URL=

# ── Markets ────────────────────────────────────────────────────────────────────

# JSON array of Kraken trading pairs to monitor. Use the base/quote format e.g. BTC/EUR.
FIXED_MARKETS=["BTC/EUR","ETH/EUR"]

# Source used to discover additional markets beyond FIXED_MARKETS.
# Options: coinmarketcap | none
DYNAMIC_UNIVERSE_SOURCE=coinmarketcap

# Maximum number of Ethereum ecosystem coins to include from the dynamic universe.
MAX_ETH_ECOSYSTEM_COINS=10

# ── Kraken API ─────────────────────────────────────────────────────────────────

# Required for live trading only. Create keys at https://www.kraken.com/u/security/api
# Required permissions: Query Funds, Query Open Orders, Create & Modify Orders.
# Leave blank for paper trading.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── News ingestion ─────────────────────────────────────────────────────────────

# JSON array of RSS sources. Each entry must be in 'Name::URL' format.
# The Fear & Greed index is always included and does not need an entry here.
NEWS_SOURCES=["CoinDesk::https://www.coindesk.com/arc/outboundfeeds/rss/","CoinTelegraph::https://cointelegraph.com/rss","The Block::https://www.theblock.co/rss.xml","Decrypt::https://decrypt.co/feed","Bitcoin Magazine::https://bitcoinmagazine.com/.rss/full/","CryptoSlate::https://cryptoslate.com/feed/","The Defiant::https://thedefiant.io/feed/","CryptoPotato::https://cryptopotato.com/feed/","NewsBTC::https://www.newsbtc.com/feed/"]

# ── External LLM — OpenAI-compatible API ──────────────────────────────────────

# Base URL of any OpenAI-compatible chat-completions endpoint.
# Leave blank to disable and use local Transformers only.
# Examples:
#   https://api.openai.com/v1       (OpenAI)
#   http://localhost:1234/v1        (LM Studio)
#   http://localhost:11434/v1       (Ollama with OpenAI compat mode)
OPENAI_BASE_URL=http://localhost:1234/v1

# API key for the endpoint. Leave blank for local servers that do not require one.
OPENAI_API_KEY=

# Model identifier to request from the endpoint (e.g. gpt-4o, google/gemma-4-e4b).
OPENAI_MODEL=

# Per-request timeout in seconds. Increase for slow or large models.
OPENAI_TIMEOUT=30

# ── Local LLM — Transformers ───────────────────────────────────────────────────

# HuggingFace model ID to load in-process via the transformers library.
# Used as fallback when OPENAI_BASE_URL is not set or the OpenAI endpoint is unreachable.
# The pipeline is unloaded from memory while the OpenAI backend is active to free RAM.
# Leave blank to disable the local fallback entirely.
# Example: google/gemma-4-E2B-it
TRANSFORMERS_LLM_MODEL=

# Per-request timeout in seconds. Local models are slower; increase for larger models.
TRANSFORMERS_TIMEOUT=60

# Maximum number of concurrent per-market LLM calls per strategy tick (LLM-only strategy).
LLM_ONLY_MAX_CONCURRENCY=3

# ── Server ─────────────────────────────────────────────────────────────────────

# Network address to bind the API server to.
# Use 0.0.0.0 to accept connections from other devices on the local network.
HOST=127.0.0.1

# HTTP port the API server listens on.
PORT=8000

# Enable Uvicorn hot-reload and verbose debug output.
# Options: true | false
DEBUG=false

# Allowed CORS origins for the dashboard frontend. JSON array of URL strings.
# Add your machine's local IP to access the dashboard from another device.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ── Database ───────────────────────────────────────────────────────────────────

# SQLite database file path, relative to the backend working directory.
DATABASE_URL=sqlite:///./trading_bot.db

# ── Logging ────────────────────────────────────────────────────────────────────

# Logging verbosity. DEBUG gives per-tick detail; INFO is recommended for normal use.
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log file path, relative to the backend working directory.
LOG_FILE=trading_bot.log
