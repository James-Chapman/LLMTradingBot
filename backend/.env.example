# Kraken Trading Bot environment template.
# Copy this file to .env in the same backend directory, then edit values for
# your local machine. BotSettings is case-sensitive, so keep keys uppercase.

# ---------------------------------------------------------------------------
# Application metadata
# ---------------------------------------------------------------------------
DEBUG=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./trading_bot.db

# ---------------------------------------------------------------------------
# Trading capital and currency
# ---------------------------------------------------------------------------
BASE_CURRENCY=EUR
STARTING_CAPITAL=500.0
TARGET_TRADE_AMOUNT=100.0

# ---------------------------------------------------------------------------
# Risk controls
# ---------------------------------------------------------------------------
MAX_LOSS_PER_TRADE_PERCENT=5.0
MAX_DAILY_LOSS_PERCENT=5.0
MIN_TRADE_SIZE=50.0
STOP_LOSS_PCT=0.05
TRAILING_STOP_PCT=0.03
MOMENTUM_LOOKBACK_TICKS=10
FEE_AND_SLIPPAGE=0.0036
MIN_SIGNAL_CONFIDENCE=0.65
LLM_VETO_THRESHOLD=0.70
MIN_24H_VOLUME=0.0
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Trading modes
# ---------------------------------------------------------------------------
TRADING_MODE=manual
TRADING_ENVIRONMENT=paper

# ---------------------------------------------------------------------------
# Kraken API
# ---------------------------------------------------------------------------
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ---------------------------------------------------------------------------
# News ingestion
# ---------------------------------------------------------------------------
# JSON array of 'Name::URL' pairs. Each entry adds an RSS source to the news
# loop. FearGreedAdapter is always included and does not need to be listed here.
NEWS_SOURCES=["CoinDesk::https://www.coindesk.com/arc/outboundfeeds/rss/","CoinTelegraph::https://cointelegraph.com/rss","The Block::https://www.theblock.co/rss.xml","Decrypt::https://decrypt.co/feed","Bitcoin Magazine::https://bitcoinmagazine.com/.rss/full/","CryptoSlate::https://cryptoslate.com/feed/","The Defiant::https://thedefiant.io/feed/","CryptoPotato::https://cryptopotato.com/feed/","NewsBTC::https://www.newsbtc.com/feed/"]

# ---------------------------------------------------------------------------
# Market universe
# ---------------------------------------------------------------------------
FIXED_MARKETS=["BTC/EUR","ETH/EUR"]
DYNAMIC_UNIVERSE_SOURCE=coinmarketcap
MAX_ETH_ECOSYSTEM_COINS=10

# ---------------------------------------------------------------------------
# External LLM — OpenAI-compatible API (preferred; leave blank to use local only)
# ---------------------------------------------------------------------------
# OPENAI_BASE_URL accepts any OpenAI-compatible endpoint:
#   https://api.openai.com/v1   (OpenAI)
#   http://localhost:1234/v1    (LM Studio)
#   http://localhost:11434/v1   (Ollama with OpenAI compat mode)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=30

# ---------------------------------------------------------------------------
# Local LLM — Transformers (HuggingFace model loaded in-process; fallback)
# ---------------------------------------------------------------------------
# Set to a HuggingFace model ID, e.g. TRANSFORMERS_LLM_MODEL=google/gemma-4-E2B-it
# Used when OPENAI_BASE_URL is not set or OpenAI becomes unavailable.
# The pipeline is unloaded from memory while OpenAI is active to free GPU/CPU RAM.
TRANSFORMERS_LLM_MODEL=
# Per-request timeout in seconds.
TRANSFORMERS_TIMEOUT=60

# Maximum concurrent per-market LLM recommendations per tick (LLM-only strategy).
LLM_ONLY_MAX_CONCURRENCY=3

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log
